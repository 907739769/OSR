# MySQL 配置
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=osr

# 应用专用数据库账号（非 root，仅拥有 MYSQL_DATABASE 库的权限，由 MySQL 镜像自动创建）
DB_USERNAME=osr_app
DB_PASSWORD=your_secure_app_db_password_here

# JWT 密钥（至少256位/32字符，请替换为强随机字符串）
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long-here

# PT 下载器密码 / 索引器 apikey 等敏感配置的加密密钥（至少32字符，请替换为强随机字符串）
# 未配置时会使用内置的兜底密钥并打印警告日志，仅能防明文落库，不具备真正的机密性，强烈建议生产环境显式配置
PT_CREDENTIAL_SECRET=your-secure-credential-secret-key-at-least-32-characters-long-here

# 时区
TZ=Asia/Shanghai

# 允许跨域访问的前端来源，逗号分隔。
# 生产环境由 Nginx 同源代理 /api，通常无需配置；
# 若前后端分域部署或直连后端 API，需显式指定（如 http://your-domain:80）。
# CORS_ALLOWED_ORIGINS=http://your-domain:80

# 后端容器内存上限（docker-compose mem_limit）。默认 2g。
# 与镜像里的 JAVA_OPTS=-XX:MaxRAMPercentage=70 是一对：堆上限按这个值的 70% 算，
# 所以调这里就等于调堆。大媒体库做 STRM 全量遍历时如果日志里出现 OutOfMemoryError，
# 优先调大它（如 4g）；宿主机内存紧张则调小（1g 起，再低会在跑迁移脚本时就吃紧）。
# BACKEND_MEM_LIMIT=2g

# 是否允许匿名访问 /actuator/**（监控端点）。默认 false，即仍需登录后的 JWT。
# 只有在内网跑 Prometheus 抓取时才设为 true——它一开，同网段任何人都能读到这些端点。
# 暴露的端点白名单在 application.yml 的 management.endpoints 里，只有
# health/info/metrics/prometheus 四个，不含 env（会吐出数据库密码）与 heapdump（内存快照）。
# 若把 6895 端口映射到了公网，这个值务必保持 false。
# ACTUATOR_ANONYMOUS=false
