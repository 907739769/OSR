<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>osr</artifactId>
        <groupId>com.osr</groupId>
        <version>4.8.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>osr-admin</artifactId>

    <description>
        web服务入口
    </description>

    <dependencies>

        <!-- Mysql驱动包 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!-- 核心模块-->
        <dependency>
            <groupId>com.osr</groupId>
            <artifactId>osr-framework</artifactId>
        </dependency>

        <!-- 定时任务-->
        <dependency>
            <groupId>com.osr</groupId>
            <artifactId>osr-quartz</artifactId>
        </dependency>

        <dependency>
            <groupId>com.osr</groupId>
            <artifactId>osr-openliststrm</artifactId>
        </dependency>

        <!--
            可观测性。此前排查只能 docker cp 出 /data/logs 再翻 sys-error.log——
            后端异常不进 stdout，容器里连「堆用了多少、连接池还剩几个、GC 停了多久」都问不出来。
            端点默认仍受 SecurityConfig 的 anyRequest().authenticated() 保护，
            要给内网 Prometheus 抓取需显式设 ACTUATOR_ANONYMOUS=true，见 SecurityConfig。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus 抓取格式；不配 Prometheus 时它只是多一个不被访问的端点，无运行时开销 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- MyBatis-Plus Generator (仅 CodeGenerator.java 使用，不打包进运行时) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
            <version>3.5.7</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.0.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>   
                <groupId>org.apache.maven.plugins</groupId>   
                <artifactId>maven-war-plugin</artifactId>   
                <version>3.0.0</version>   
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>   
            </plugin>   
        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>
